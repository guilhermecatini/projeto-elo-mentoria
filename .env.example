# Copie para .env em desenvolvimento e preencha com valores aleatórios.
# Produção: scripts/install-app.sh cria e protege .env sem sobrescrever.
COMPOSE_PROJECT_NAME=elo-mentoria
NODE_ENV=production
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
APP_ORIGIN=https://mentoria.exemplo.com.br
SITE_ADDRESS=mentoria.exemplo.com.br
ADMIN_EMAIL=
ADMIN_NAME=Administrador
# Exclusivo de desenvolvimento, nunca usar em produção.
DEMO_PASSWORD=

# Integrações opcionais. Deixe vazio enquanto não houver contas oficiais configuradas.
# As credenciais abaixo ficam no servidor; não são exibidas pela aplicação.
INTEGRATION_ORGANIZATION_ID=
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
